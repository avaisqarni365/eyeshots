# ── Web (apps/web) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Protects /admin with HTTP Basic auth. If unset, /admin returns 404 in production.
ADMIN_USER=
ADMIN_PASSWORD=
# Sends selected text to a third-party translation API. Keep false (privacy promise).
NEXT_PUBLIC_ALLOW_THIRD_PARTY_TRANSLATION=false
# Build a static export for the Tauri desktop app (outputs apps/web/out).
# TAURI_BUILD=1

# ── API gateway (services/api-gateway) ──────────────────────
NODE_ENV=development
PORT=4000
STIRLING_ENGINE_URL=http://localhost:8080
# REQUIRED in production: generate with `openssl rand -hex 32`. The gateway refuses to start with the default.
INTERNAL_STIRLING_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost
MAX_UPLOAD_MB=100
RATE_LIMIT_PER_MINUTE=30
# Number of reverse proxies in front of the gateway (for correct client IPs / rate limiting).
TRUST_PROXY_HOPS=0
# Bearer token (>= 24 chars) for /api/v1/admin/*. Admin API is disabled when unset.
ADMIN_API_TOKEN=
# Mock accounting/legal endpoints for UI prototyping. Must be false in production.
ENABLE_DEMO_ENDPOINTS=false

# ── Async job queue (see docs/13-ASYNC-JOB-QUEUE.md) ─────────
# Enables /api/jobs. Without it, the web client falls back to synchronous /api/tools.
REDIS_URL=redis://localhost:6379
# fs = shared tmpfs volume (single host) · s3 = S3-compatible bucket (multi-host)
JOB_STORE=fs
# JOB_STORE_DIR=/jobs
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ENDPOINT=            # for MinIO / R2 / Hetzner
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= (standard AWS SDK credentials)
# TTL + sweep interval must be <= 120 (2-hour zero-retention policy).
JOB_TTL_MINUTES=110
JOB_SWEEP_MINUTES=5
WORKER_CONCURRENCY=2
QUEUE_MAX_WAITING=500

# -- Accounts, sessions & quotas (see docs/14-ACCOUNTS-AND-BILLING.md) --
# Postgres for users/sessions/subscriptions/usage. Without it, accounts, billing and quotas are off (dev only).
DATABASE_URL=postgres://eyeshots:eyeshots_dev_password@localhost:5432/eyeshots
# Host port for the compose Postgres (5432 can be reserved on Windows/Hyper-V; e.g. 55433).
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=eyeshots_dev_password
# REQUIRED in production, >= 32 chars: openssl rand -hex 32
AUTH_SECRET=
# Public URL of the web app (emails, Stripe redirects).
APP_URL=http://localhost:3000
SESSION_DAYS=30
# REQUIRED in production. Without it in development, sign-in codes are printed to the gateway log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=EyeShots <no-reply@example.com>

# -- Stripe billing --
# Leave STRIPE_SECRET_KEY empty to disable checkout (pricing page shows a contact link).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# Requires Stripe Tax to be activated in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false
