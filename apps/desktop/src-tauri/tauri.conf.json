{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EyeShots",
  "version": "1.0.0",
  "identifier": "com.eyeshots.desktop",
  "build": {
    "frontendDist": "../web/out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "EyeShots - Privacy-First PDF & Markdown Suite",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
